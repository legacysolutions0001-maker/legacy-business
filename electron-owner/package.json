{
  "name": "legacy-business-owner",
  "version": "1.0.0",
  "description": "Legacy Business Owner — Management & Licensing Control Application",
  "main": "main.js",
  "author": "Legacy Solutions",
  "license": "SEE LICENSE IN installer/LICENSE.txt",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "npm run build:all && electron-builder",
    "build:win": "npm run build:all && electron-builder --win",
    "build:win:portable": "npm run build:all && electron-builder --win portable",
    "build:linux": "npm run build:all && electron-builder --linux",
    "build:all": "cd .. && pnpm --filter @workspace/legacy-business run build && pnpm --filter @workspace/api-server run build",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.legacysolutions.owner",
    "productName": "Legacy Business Owner",
    "copyright": "Copyright © 2025 Legacy Solutions",
    "directories": {
      "output": "../dist-electron-owner"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../artifacts/api-server/dist",
        "to": "api-server/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../artifacts/legacy-business/dist/public",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "../lib/db/migrations",
        "to": "migrations",
        "filter": ["**/*"]
      },
      {
        "from": "../firebase-service-account.json",
        "to": "firebase-service-account.json",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "icons/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "publisherName": "Legacy Solutions",
      "legalTrademarks": "Legacy Solutions"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico",
      "installerHeaderIcon": "icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Legacy Business Owner",
      "menuCategory": "Legacy Solutions",
      "license": "installer/LICENSE.txt",
      "artifactName": "Legacy Business Owner Setup.exe",
      "include": "installer/custom.nsi",
      "warningsAsErrors": false,
      "installerLanguages": ["English"],
      "displayLanguageSelector": false
    },
    "portable": {
      "artifactName": "Legacy Business Owner Portable.exe"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icons/icon.png",
      "category": "Office",
      "maintainer": "Legacy Solutions <legacysolutions0001@gmail.com>"
    },
    "mac": {
      "target": "dmg",
      "icon": "icons/icon.png",
      "category": "public.app-category.business"
    },
    "publish": null
  }
}
